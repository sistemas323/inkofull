# Datos de la operación: NO se versionan.
# Aquí viven la base de datos y las fotos de evidencia — información real del
# almacén, con nombres y PIN del equipo. Un historial de versiones es para el
# código, no para los datos. Su respaldo es la carpeta 'respaldos' y OneDrive.
datos/

# Node no se usa aquí (la plataforma no tiene dependencias), pero si algún día
# se agregan, que no entren al historial.
node_modules/

# Secretos y entorno. Un .env.example, si llega a existir, sí se versiona.
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Compilación y temporales. Hoy no hay build; quedan fuera por si aparece.
dist/
build/
.next/
out/
coverage/
*.log
*.tmp
*.bak
*.backup

# Basura del sistema
Thumbs.db
desktop.ini
.DS_Store

# Copias de seguridad de los datos: mismo motivo que 'datos'.
respaldos/
